# ============================================================
# 小洋 —— 环境变量样例
# 复制为 .env 供本地开发注入（Vercel 上在项目 Settings 配同名变量）
# .env 已被 .gitignore 忽略，请勿提交真实密钥
# ============================================================

# --- DeepSeek（必填，否则小洋开不了口）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_MAX_TOKENS=600

# --- 记忆 ---
# 本地开发用 json；Vercel 生产必须改成 upstash（serverless 文件系统只读）
MEMORY_BACKEND=json
MEMORY_JSON_PATH=data/memory.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 完整保留最近多少条消息；超出后旧对话被摘要成长期记忆
HISTORY_WINDOW=20
SUMMARIZE_TRIGGER=32

# --- RAG 知识库 ---
RAG_ENABLED=true
# bm25（默认，serverless 可用，无模型下载）
RAG_BACKEND=bm25
KNOWLEDGE_DIR=knowledge
RAG_TOP_K=3

# --- 企业微信（可选，次要渠道）---
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_TOKEN=xiaoyang666
WECHAT_ENCODING_AES_KEY=

# --- 单用户标识（当前产品只服务一个人）---
USER_ID=me

# --- API 访问令牌（保护聊天接口，防止陌生人使用）---
API_TOKEN=
# 网页版入口密码（可选；不设则网页版无需密码）
WEB_PASSWORD=

# --- CORS（逗号分隔；* 表示全部）---
ALLOWED_ORIGINS=*
